# =============================================================================
# Football Predictor — backend environment
# Copy this file to  backend/.env  and fill in real values.
#   cp .env.example backend/.env
# NOTE: .env is gitignored. Never commit real keys.
# =============================================================================

# ---- App ----
APP_NAME="Football Predictor"
ENVIRONMENT=development            # development | production

# Secret used for JWT signing AND for encrypting provider API keys at rest.
# Generate a strong one:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY="change-me-to-a-long-random-string-at-least-32-chars"

# ---- Database ----
# SQLite for local dev. Swap to Postgres later without code changes, e.g.:
#   DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/football
DATABASE_URL="sqlite:///./football_predictor.db"

# ---- Admin login (single user, no public signup) ----
ADMIN_USERNAME=admin
# Change this. Password is compared against a hash generated at runtime.
ADMIN_PASSWORD="change-me"
ACCESS_TOKEN_EXPIRE_MINUTES=1440   # 24h

# ---- API-Football provider ----
# Get a key at https://www.api-football.com/  (free tier available).
# Leave blank to run in OFFLINE SAMPLE MODE (canned Premier League data),
# which is enough to see the whole pipeline + frontend work end to end.
API_FOOTBALL_KEY=""
API_FOOTBALL_BASE_URL="https://v3.football.api-sports.io"

# ---- Defaults (Premier League on API-Football) ----
DEFAULT_LEAGUE_EXTERNAL_ID=39      # 39 = Premier League in API-Football
DEFAULT_SEASON=2023                # free tier is limited to older seasons

# ---- Provider caching (seconds) ----
CACHE_TTL_STATS=21600              # 6h  — team stats change rarely
CACHE_TTL_FIXTURES=3600            # 1h  — fixtures / gameweek
CACHE_TTL_H2H=21600                # 6h  — head-to-head history
# Minimum seconds between outbound calls to the same provider (throttle).
PROVIDER_MIN_INTERVAL=1.0

# ---- CORS ----
FRONTEND_ORIGIN="http://localhost:5173"

# ---- The Odds API (optional; bookmaker over/under lines) ----
# Free key at https://the-odds-api.com — 500 credits/month. Blank = odds hidden.
THE_ODDS_API_KEY=""
